# ===== Receptor Engineering Hub — performance config =====
# Use this file ONLY if you host on Netlify or Cloudflare Pages.
# (Compression is automatic on these hosts — this just sets cache lifetimes.)
# If you're on Apache/cPanel shared hosting, delete this and use .htaccess instead.

/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=2592000
/js/*
  Cache-Control: public, max-age=2592000
